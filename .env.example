# Get from https://resend.com/api-keys (Full access key — needs send + read)
RESEND_API_KEY=re_xxxxxxxx

# Webhook signing secret, shown when you create a webhook in the Resend dashboard.
# Used to verify that incoming POSTs to /api/webhook are actually from Resend.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# Your verified sending domain
MAIL_DOMAIN=hax429.me
DEFAULT_FROM="Hax <me@hax429.me>"

# Where the SQLite file lives. On Fly.io, this should be on the mounted volume.
DATABASE_PATH=./data/mail.db
